{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Destek Programı Şablonu",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Desteğin benzersiz kimliği"
    },
    "kurum": {
      "type": "string",
      "description": "Desteği sağlayan kurum (örn. KOSGEB)"
    },
    "destek_adi": {
      "type": "string",
      "description": "Destek programının tam adı"
    },
    "kategori": {
      "type": "string",
      "description": "Desteğin kategorisi (örn. Ar-Ge, İhracat)"
    },
    "maksimum_tutar": {
      "type": "number",
      "description": "Sağlanan maksimum finansal destek (TL cinsinden)"
    },
    "basvuru_linki": {
      "type": "string",
      "description": "Resmi başvuru adresi URL'si"
    },
    "hedef_kitle": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Destek programının hedef kitlesi (örn. KOBİ, Girişimci)"
    },
    "son_basvuru_tarihi": {
      "type": "string",
      "format": "date",
      "description": "Desteğe başvurulabilecek son tarih (Sürekli açık ise null)"
    }
  },
  "required": ["id", "kurum", "destek_adi", "kategori", "maksimum_tutar", "basvuru_linki"]
}
